# Configuração comum do HDFS (convertida em core-site.xml / hdfs-site.xml pelo envtoconf da imagem apache/hadoop)
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.replication=3
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.namenode.name.dir=/data/nn
HDFS-SITE.XML_dfs.datanode.data.dir=/data/dn
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.http-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
# Os DataNodes anunciam um hostname alcançável (nome do serviço aqui; IP da máquina Windows em modo distribuído)
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
# Detecção mais rápida de DataNodes mortos (por omissão são ~10 min)
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=30000
HDFS-SITE.XML_dfs.heartbeat.interval=3
HADOOP_HEAPSIZE_MAX=384m
