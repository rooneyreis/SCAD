# Build da loja React (Vite) e servidor nginx com proxy para a API pública da loja nos nós.
FROM node:20-alpine AS build
WORKDIR /loja
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /loja/dist /usr/share/nginx/html
EXPOSE 8085
